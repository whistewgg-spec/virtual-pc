{
  "name": "Virtual PC",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": true,
      "moby": true
    }
  },
  "forwardPorts": [8006, 3389, 6080],
  "portsAttributes": {
    "8006": {
      "label": "Windows Desktop",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "6080": {
      "label": "Linux Desktop",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "3389": {
      "label": "RDP",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "WORKDIR=${GITHUB_WORKSPACE:-/workspaces/virtual-pc} && docker compose -f ${WORKDIR}/windows.yml up -d || true",
  "remoteUser": "codespace"
}